{
  "francorMaqueen.start": "francorMaqueen.start()\nbasic.showIcon(IconNames.Happy)",
  "francorMaqueen.startV2": "francorMaqueen.startV2()\nbasic.showIcon(IconNames.Happy)",
  "francorMaqueen.drive": "francorMaqueen.start()\nfrancorMaqueen.drive(60, 40)",
  "francorMaqueen.driveBoth": "francorMaqueen.start()\nfrancorMaqueen.driveBoth(50)\nbasic.pause(1000)\nfrancorMaqueen.stop()",
  "francorMaqueen.stop": "francorMaqueen.start()\nfrancorMaqueen.driveBoth(50)\nbasic.pause(1000)\nfrancorMaqueen.stop()",
  "francorMaqueen.driveV2": "francorMaqueen.startV2()\nfrancorMaqueen.driveV2(60, 40)",
  "francorMaqueen.stopV2": "francorMaqueen.startV2()\nfrancorMaqueen.driveV2(50, 50)\nbasic.pause(1000)\nfrancorMaqueen.stopV2()",
  "francorMaqueen.seesLine": "francorMaqueen.start()\nbasic.forever(function () {\n    if (francorMaqueen.seesLine(francorMaqueen.LineSensor.M)) {\n        basic.showIcon(IconNames.Yes)\n    } else {\n        basic.showIcon(IconNames.No)\n    }\n})",
  "francorMaqueen.sensorRaw": "francorMaqueen.start()\nbasic.forever(function () {\n    basic.showNumber(francorMaqueen.sensorRaw(francorMaqueen.LineSensor.M))\n})",
  "francorMaqueen.linePosition": "francorMaqueen.start()\nbasic.forever(function () {\n    if (francorMaqueen.linePosition() == 100) {\n        francorMaqueen.stop()\n    } else {\n        francorMaqueen.drive(40 - 20 * francorMaqueen.linePosition(), 40 + 20 * francorMaqueen.linePosition())\n    }\n})",
  "francorMaqueen.patrol": "francorMaqueen.start()\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)",
  "francorMaqueen.patrolSpeed": "francorMaqueen.start()\nfrancorMaqueen.patrolSpeed(2)\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)",
  "francorMaqueen.atCrossroad": "francorMaqueen.start()\nfrancorMaqueen.atCrossroad(francorMaqueen.CrossroadRule.Straight)\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)",
  "francorMaqueen.atTJunction": "francorMaqueen.start()\nfrancorMaqueen.atTJunction(francorMaqueen.TRule.Left)\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)",
  "francorMaqueen.atLeftOrStraight": "francorMaqueen.start()\nfrancorMaqueen.atLeftOrStraight(francorMaqueen.LeftRule.Straight)\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)",
  "francorMaqueen.atRightOrStraight": "francorMaqueen.start()\nfrancorMaqueen.atRightOrStraight(francorMaqueen.RightRule.Right)\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)",
  "francorMaqueen.junction": "francorMaqueen.start()\nbasic.forever(function () {\n    if (francorMaqueen.junction() == francorMaqueen.isJunction(francorMaqueen.Junction.TJunction)) {\n        basic.showIcon(IconNames.Yes)\n    }\n})",
  "francorMaqueen.isJunction": "francorMaqueen.start()\nbasic.forever(function () {\n    if (francorMaqueen.junction() == francorMaqueen.isJunction(francorMaqueen.Junction.Crossroad)) {\n        basic.showIcon(IconNames.Yes)\n    }\n})",
  "francorMaqueen.onCrossing": "francorMaqueen.start()\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)\nfrancorMaqueen.onCrossing(1, function () {\n    francorMaqueen.atRightOrStraight(francorMaqueen.RightRule.Straight)\n})",
  "francorMaqueen.crossingsCounted": "francorMaqueen.start()\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)\ninput.onButtonPressed(Button.B, function () {\n    basic.showNumber(francorMaqueen.crossingsCounted())\n})",
  "francorMaqueen.resetCrossings": "francorMaqueen.start()\nfrancorMaqueen.resetCrossings()\nfrancorMaqueen.patrol(francorMaqueen.OnOff.On)",
  "francorMaqueen.setLight": "francorMaqueen.start()\nfrancorMaqueen.setLight(francorMaqueen.Led.One, francorMaqueen.colors(francorMaqueen.Colors.Red))",
  "francorMaqueen.colors": "francorMaqueen.start()\nfrancorMaqueen.setLight(francorMaqueen.Led.All, francorMaqueen.colors(francorMaqueen.Colors.Green))",
  "francorMaqueen.rgb": "francorMaqueen.start()\nfrancorMaqueen.setLight(francorMaqueen.Led.All, francorMaqueen.rgb(255, 128, 0))",
  "francorMaqueen.brightness": "francorMaqueen.start()\nfrancorMaqueen.brightness(60)\nfrancorMaqueen.setLight(francorMaqueen.Led.All, francorMaqueen.colors(francorMaqueen.Colors.White))",
  "francorMaqueen.lightsOff": "francorMaqueen.start()\nfrancorMaqueen.setLight(francorMaqueen.Led.All, francorMaqueen.colors(francorMaqueen.Colors.Blue))\nbasic.pause(1000)\nfrancorMaqueen.lightsOff()",
  "francorMaqueen.headlight": "francorMaqueen.start()\nfrancorMaqueen.headlight(francorMaqueen.Side.Both, francorMaqueen.HeadColor.Red)",
  "francorMaqueen.driveDistance": "francorMaqueen.start()\nfrancorMaqueen.driveDistance(20, francorMaqueen.Dir.Forward, francorMaqueen.Wait.UntilDone)\nbasic.showIcon(IconNames.Yes)",
  "francorMaqueen.turn": "francorMaqueen.start()\nfrancorMaqueen.turn(90, francorMaqueen.Wait.UntilDone)\nbasic.showIcon(IconNames.Yes)",
  "francorMaqueen.pidStop": "francorMaqueen.start()\nfrancorMaqueen.driveDistance(100, francorMaqueen.Dir.Forward, francorMaqueen.Wait.Continue)\ninput.onButtonPressed(Button.A, function () {\n    francorMaqueen.pidStop()\n})",
  "francorMaqueen.wheelSpeed": "francorMaqueen.start()\nbasic.forever(function () {\n    basic.showNumber(francorMaqueen.wheelSpeed(francorMaqueen.Side.Both))\n})",
  "francorMaqueen.ambientLight": "francorMaqueen.start()\nbasic.forever(function () {\n    basic.showNumber(francorMaqueen.ambientLight(francorMaqueen.Side.Left))\n})",
  "francorMaqueen.version": "francorMaqueen.start()\nbasic.showString(francorMaqueen.version())",
  "francorMaqueen.redLed": "francorMaqueen.startV2()\nfrancorMaqueen.redLed(francorMaqueen.Side.Both, francorMaqueen.OnOff.On)",
  "francorMaqueen.ultrasonic": "francorMaqueen.startV2()\nbasic.forever(function () {\n    basic.showNumber(francorMaqueen.ultrasonic())\n})",
  "francorLidar.start": "francorMaqueen.start()\nfrancorLidar.start()",
  "francorLidar.distance": "francorMaqueen.start()\nfrancorLidar.start()\nbasic.forever(function () {\n    if (francorLidar.distance(francorLidar.LidarSide.Front) < 200) {\n        francorMaqueen.stop()\n    }\n})",
  "francorLidar.direction": "francorMaqueen.start()\nfrancorLidar.start()\nbasic.forever(function () {\n    if (francorLidar.direction() == francorLidar.isDirection(francorLidar.AvoidDir.Left)) {\n        basic.showArrow(ArrowNames.West)\n    }\n})",
  "francorLidar.isDirection": "francorMaqueen.start()\nfrancorLidar.start()\nbasic.forever(function () {\n    if (francorLidar.direction() == francorLidar.isDirection(francorLidar.AvoidDir.Free)) {\n        basic.showIcon(IconNames.Yes)\n    }\n})",
  "francorLidar.setAvoidDistance": "francorMaqueen.start()\nfrancorLidar.setAvoidDistance(200)\nfrancorLidar.start()"
}
